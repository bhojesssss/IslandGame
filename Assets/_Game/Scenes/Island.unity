  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ClueNote
  interactRadius: 1.4
  interactOffset: {x: 0, y: 0.3}
  title: Sobekan Peta
  body: 'Sobekan peta tua terselip di dekat sumur...


    <i>"Dari sumur tua, berjalanlah
    ke <b>timur laut</b> melewati makam-makam. Di antara <b>dua lentera batu</b>,
    hartaku terkubur di dalam tanah."</i>


    Carilah <b>tanda X</b> di tanah,
    lalu <b>gali</b>!'
  unreadMarker: {fileID: 1342609504}
  onFirstRead:
    m_PersistentCalls:
