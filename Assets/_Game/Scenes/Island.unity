  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ClueNote
  interactRadius: 1.4
  interactOffset: {x: 0, y: 0.3}
  title: Prasasti Rune
  body: 'Empat pilar rune menjaga gerbang hutan terlarang di utara.

    Sentuhlah
    mereka mengikuti perjalanan sang mentari:


    <i>Lahir di <b>Timur</b>,

    menghangatkan
    bumi di <b>Selatan</b>,

    tenggelam di <b>Barat</b>,

    lalu tidur di bawah
    bintang <b>Utara</b>.</i>


    Salah urutan, dan cahaya rune akan padam kembali.'
  unreadMarker: {fileID: 2040740471}
  onFirstRead:
    m_PersistentCalls:
      m_Calls: []
