  m_Script: {fileID: 11500000, guid: 0647f3682f61d894b838d18802f96578, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ClueNote
  interactRadius: 1.4
  interactOffset: {x: 0, y: 0.3}
  title: Catatan Kapten
  body: "Kapalku hancur dihantam badai, dan aku terdampar di pulau aneh ini...\n\nPenduduk
    lama pulau ini membangun sebuah <b>portal kuno</b> di sebelah <b>utara</b>. Konon
    portal itu bisa membawa siapa pun pulang, tapi hanya menyala jika diberi <b>3
    kristal</b>.\n\nDari pantai ini aku melihat:\n\u2022 Cahaya biru dari pilar-pilar
    rune di <b>barat daya</b>.\n\u2022 Kamp para orc di <b>timur</b> yang menjaga
    sebuah peti.\n\u2022 Sumur tua di <b>tengah pulau</b>, ada sesuatu terselip di
    sana.\n\nEmas bisa dipersembahkan di <b>patung kuil</b> dekat pantai untuk menjadi
    lebih kuat."
  unreadMarker: {fileID: 1655641325}
  onFirstRead:
    m_PersistentCalls:
      m_Calls: []
